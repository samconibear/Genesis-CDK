  "description": "CDK constructs for deploying static websites on AWS with CloudFront, S3, Route53, and ACM",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "genesis-cdk": "lib/cli.js"
  },
  "files": [
